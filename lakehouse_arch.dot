digraph DataArchitecture {
    // Global layout and style
    graph [
        fontname="Helvetica", fontsize=14,
        rankdir=TB,
        nodesep=1.0,
        ranksep=1.8,
        splines=true,
        overlap=false,
        margin=0.4,
        label="\n\nData Platform Architecture",
        labelloc=top,
        fontsize=24
    ];

    node [
        shape=box, style="rounded,filled", fillcolor="#f9f9f9",
        fontname="Helvetica-Bold", fontsize=14,
        width=3.2, height=0.8,
        penwidth=1.2
    ];

    // Source Systems
    subgraph cluster_sources {
        label="Source Systems"; style="rounded,filled"; fillcolor="#e3f2fd";
        margin=15;
        ticketing_system [label="Ticketing System\n(ServiceNow / Zendesk)"];
        crm_system       [label="CRM System\n(Dynamics 365 / Salesforce)"];
        operational_db   [label="Operational DB\n(SQL Server / Azure SQL DB)"];
        mobile_app       [label="Mobile App\n(Azure App Service / Mobile Apps)"];
        iot_devices      [label="IoT Devices\n(Azure IoT Hub / MQTT)"];
    }

    // Ingestion Layer
    subgraph cluster_ingestion {
        label="Ingestion Layer"; style="rounded,filled"; fillcolor="#e8f5e9";
        margin=15;
        adf        [label="Azure Data Factory\n(Batch Ingestion / CDC)"];
        eventhub   [label="Azure Event Hub\n(Stream Ingestion / Kafka)"];
        autoloader [label="Databricks Autoloader\n(Auto Ingest Files)"];
    }

    // Bronze Layer (Raw)
    subgraph cluster_bronze {
        label="Bronze Layer (Raw)"; style="rounded,filled"; fillcolor="#fce4ec";
        margin=15;
        bronze_operational [label="Operational Raw\n(Azure Data Lake Gen2)"];
        bronze_crm         [label="CRM Raw\n(Azure Data Lake Gen2)"];
        bronze_ticketing   [label="Ticketing Raw\n(Azure Data Lake Gen2)"];
        bronze_iot         [label="IoT Raw\n(Azure Data Lake Gen2)"];
        bronze_mobile      [label="Mobile Raw\n(Azure Data Lake Gen2)"];
    }

    // Transformations Layer
    subgraph cluster_transformations {
        label="Transformations Layer"; style="rounded,filled"; fillcolor="#f3e5f5";
        margin=15;
        spark_jobs [label="Spark Jobs\n(Heavy ETL – PySpark)"];
        dbt_core   [label="dbt Core\n(Light Transformations)"];
    }

    // Silver Layer (Cleansed)
    subgraph cluster_silver {
        label="Silver Layer (Cleansed)"; style="rounded,filled"; fillcolor="#fff3e0";
        margin=15;
        silver_workorders       [label="Work Orders\n(Databricks Delta Lake)"];
        silver_equipment        [label="Equipment Telemetry\n(Databricks Delta Lake)"];
        silver_service_notes    [label="Service Notes\n(Databricks Delta Lake)"];
        silver_customer_profiles[label="Customer Profiles\n(Databricks Delta Lake)"];
        silver_support_cases    [label="Support Cases\n(Databricks Delta Lake)"];
    }

    // Gold Layer
    subgraph cluster_gold {
        label="Gold Layer (Feature Ready)"; style="rounded,filled"; fillcolor="#ede7f6";
        margin=15;
        gold_churn_features       [label="Customer Churn Features\n(Databricks Feature Store)"];
        gold_maintenance_features [label="Predictive Maintenance Features\n(Databricks Feature Store)"];
        gold_technician_routing   [label="Technician Routing Features\n(Databricks Feature Store)"];
        gold_cv_training_data     [label="Computer Vision Images Metadata\n(Databricks Feature Store)"];
    }

    // ML/AI
    subgraph cluster_ml {
        label="ML/AI Serving"; style="rounded,filled"; fillcolor="#f1f8e9";
        margin=15;
        feature_store   [label="Databricks Feature Store\n(MLflow / Feast)"];
        model_training  [label="Model Training Pipelines\n(Databricks ML / Azure ML)"];
        llm_assistant   [label="LLM Assistant Serving Layer\n(Azure OpenAI / Databricks LLM)"];
    }

    // Governance Layer
    subgraph cluster_governance {
        label="Data Governance Layer"; style="rounded,filled"; fillcolor="#e0f7fa";
        margin=15;
        data_quality      [label="Data Quality\n(Azure Purview)"];
        lineage_tracking  [label="Lineage\n(Azure Purview)"];
        metadata_mgmt     [label="Metadata\n(Azure Purview)"];
        sensitive_data    [label="Sensitive Data\n(Azure Purview)"];
        monitoring_alerts [label="Monitoring & Alerts\n(Azure Monitor)"];
    }

    // Flows: Sources → Ingestion
    ticketing_system -> adf;
    crm_system       -> adf;
    operational_db   -> adf;
    iot_devices      -> eventhub;
    mobile_app       -> autoloader;

    // Ingestion → Bronze
    adf        -> {bronze_operational bronze_crm bronze_ticketing};
    eventhub   -> bronze_iot;
    autoloader -> bronze_mobile;

    // Bronze → Transformations
    {bronze_iot bronze_mobile} -> spark_jobs;
    {bronze_operational bronze_crm bronze_ticketing} -> dbt_core;

    // Transformations → Silver
    spark_jobs -> {silver_equipment silver_service_notes};
    dbt_core   -> {silver_workorders silver_customer_profiles silver_support_cases};

    // Silver → Gold
    silver_workorders       -> gold_maintenance_features;
    silver_equipment        -> gold_maintenance_features;
    silver_service_notes    -> gold_technician_routing;
    silver_customer_profiles-> gold_churn_features;
    silver_support_cases    -> gold_churn_features;
    silver_service_notes    -> gold_cv_training_data;

    // Gold → ML/AI
    {gold_churn_features gold_maintenance_features gold_technician_routing} -> feature_store;
    gold_cv_training_data -> model_training;
    feature_store         -> model_training;
    model_training        -> llm_assistant;

    // Governance overlays
    data_quality      -> {bronze_operational bronze_crm bronze_ticketing bronze_iot bronze_mobile} [style=dashed];
    lineage_tracking  -> {bronze_operational silver_workorders gold_churn_features} [style=dashed];
    metadata_mgmt     -> {bronze_operational silver_workorders gold_churn_features} [style=dashed];
    sensitive_data    -> {silver_customer_profiles gold_churn_features} [style=dashed];
    monitoring_alerts -> {feature_store model_training llm_assistant} [style=dashed];
}